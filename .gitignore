node_modules/
.env
*.log

# ─── 렌더 결과 — 스크립트로 다시 만들 수 있습니다 ───
# 카드 내용(_spec.json)만 남겨서 재현 가능하게 둡니다.
out/**
!out/cards/
!out/cards/*/
!out/cards/*/_spec.json

# 세팅 가이드 PDF — node pdf.mjs 로 재생성
*.pdf

# 전문가 검토 의뢰서 — node 검토의뢰서.mjs 로 재생성
# 미발행 초안 내용이 통째로 들어가고 사외로 나가는 파일이라 저장소에 두지 않습니다.
검토의뢰_*.html

# ─── 남의 블로그 본문 ───
# research/extract.mjs 가 긁어온 상위 노출 글 전문입니다.
# 학습용 참고 자료일 뿐 우리 저작물이 아니므로 저장소에 넣지 않습니다.
# 필요하면 `node research/extract.mjs` 로 다시 수집합니다.
research/out/corpus/

# 백업 스냅샷
*.bak
research/out/*백업*.json

.DS_Store

# 미발행 초안 — 공개 저장소라 두지 않습니다.
# 구글이 초안을 먼저 색인하면 네이버가 우리 발행글을 중복으로 볼 수 있습니다.
# 이 저장소의 목적은 «어떻게 세팅했고 어떤 방식으로 쓰는가» 이지 원고 보관이 아닙니다.
posts/

# 검토 의뢰 메일 초안 — 미발행 원고 제목과 검토 항목이 들어갑니다.
검토의뢰-메일.md
